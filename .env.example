# Copy this file to `.env` (e.g. `cp .env.example .env`).
# `.env` is read automatically by `npm start` / `npm run build`, and by Docker
# Compose for `${...}` substitution. Variables already set in the shell or
# container environment take precedence over this file.

# Public hostname for automatic HTTPS (Let's Encrypt). Leave empty for local HTTP on port 3000.
# For a different local port, set e.g. DOMAIN=:8080
DOMAIN=

# Admin portal (/admin). Leave ADMIN_USERNAME/ADMIN_PASSWORD empty to disable it.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Optional. Keeps admin sessions valid across restarts; a stable random string is enough.
ADMIN_SESSION_SECRET=
